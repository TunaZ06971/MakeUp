# 复制为 .env.local 并填入你的 Firebase 项目配置（Firebase 控制台 → 项目设置 → 你的应用）。
# 留空则自动连接本地 Firebase Emulator Suite（项目 id：demo-makeup），无需任何云端账号。
#
# Copy to .env.local and fill in your Firebase web app config.
# Leave unset to run against the local Firebase Emulator Suite (project id: demo-makeup).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
