    "scan.feedback.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a physical iPhone that supports ARKit face tracking. The simulator cannot capture. You can also import a model."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "需要支持 ARKit 人脸追踪的 iPhone 真机；模拟器无法采集。你也可以导入已有模型。"
          }
        }
      }
