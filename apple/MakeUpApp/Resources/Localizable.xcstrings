        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续慢慢向左转，约 60°，不要超过 90°"
          }
        }
      }
    },
    "scan.steps.rightProfile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue slowly right to about 60°, never beyond 90°"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续慢慢向右转，约 60°，不要超过 90°"
          }
        }
      }
    },
    "scan.sources.truedepth-measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrueDepth · measured visible surface (experimental)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TrueDepth · 测量可见表面（实验功能）"
          }
        }
      }
    },
    "scan.feedback.noDepth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No synchronized, calibrated TrueDepth data. Use a TrueDepth iPhone, keep your face in view and retry. Do not use Simulator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有获取到同步且标定有效的 TrueDepth 数据。请使用有 TrueDepth 的真实 iPhone，将脸保持在画面中后重试。模拟器无法采集。"
          }
        }
      }
    },
    "scan.feedback.waitingDepth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for synchronized depth measurements…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待同步的原始深度数据…"
          }
        }
      }
    },
    "scan.feedback.insufficientDepth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough reliable depth to build a surface. Keep the whole head in frame, use soft light and move slowly. The previous model was retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可靠深度不足，暂时无法生成表面。请让整个头部入镜，在柔和光线下慢慢转头。原有模型已保留。"
          }
        }
      }
    },
    "scan.measuredSurfaceNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured visible regions only. Unseen areas remain missing; hair strands and hidden ear folds are not reconstructed. Expressions are not applied to this measured surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含测到的可见区域。未拍到的部分仍缺失；不重建单根发丝或耳内遮挡结构。测量表面暂不支持表情变形。"
          }
        }
      }
    },
    "scan.skipProfile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot track this angle — continue without it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此角度无法跟踪，继续采集其他视角"
          }
        }
      }
    }
  },
  "version": "1.0"
}
