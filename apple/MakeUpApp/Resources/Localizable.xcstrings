    "face.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a front-facing photo to start trying makeup on. Even lighting and clearly visible features work best."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入一张正脸照片，就可以开始试妆了。光线均匀、五官清晰的照片效果最好。"
          }
        }
      }
    },
    "face.import": {
      "extractionState": "manual",
