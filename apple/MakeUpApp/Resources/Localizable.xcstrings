    "scan.measuredMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure visible head depth (experimental)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量可见头部深度（实验功能）"
          }
        }
      }
    },
    "scan.measuredNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses raw TrueDepth measurements, not the ARKit face template. Visible hair and ears may be retained when the sensor observes them. Missing regions stay open. Real-device quality has not been verified yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 TrueDepth 原始测量，不以 ARKit 人脸模板作为成品。传感器测到的可见头发与耳朵可参与重建，缺失区域保持空缺。尚未完成真机质量验收。"
          }
        }
      }
    },
    "scan.coarseNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick coarse face template; no hair, ears or complete head reconstruction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速粗略脸部模板，不含头发、耳朵，不是完整头部重建。"
          }
        }
      }
    },
    "scan.captureSide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available capture direction"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可拍摄方向"
          }
        }
      }
    },
