    "scan.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "scan.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your head. Capture your own face."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "转动头部，采集属于你的脸型"
          }
        }
      }
    },
    "scan.prepare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the camera steady with your face, hair and ears in view and soft light in front. You can capture just one side without filming the back. Keep a neutral expression during turns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头保持稳定，让整张脸、发顶和耳朵入镜，面向柔和光源。可只采左侧或右侧，不需要拍后脑；转头时保持自然表情。"
          }
        }
      }
    },
    "scan.rgbNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A standard camera creates an estimated surface in relative units. Use ARKit on an iPhone with TrueDepth for the primary acquisition route."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "普通摄像头生成相对尺度的估算面部网格。更可靠的几何请使用 iPhone 的 ARKit / TrueDepth 采集。"
          }
        }
      }
    },
    "scan.deviceAdvice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture on iPhone and AirDrop the model file here, or use this computer’s camera."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐用 iPhone 采集后，将模型文件通过 AirDrop 导入这里；也可以直接用本机摄像头。"
          }
        }
      }
    },
    "scan.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone. Frames, geometry and expressions stay on this device. Only an explicit export creates a transferable file. This is not identity verification."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头不录音。采集帧、几何和表情只保存在本设备；只有你主动导出时才生成可转移文件。此流程不是身份认证。"
          }
        }
      }
    },
    "scan.startCamera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable camera and begin"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "开启摄像头并开始"
          }
        }
      }
    },
    "scan.start": {
